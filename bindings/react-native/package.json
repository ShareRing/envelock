{
  "name": "@sharering/react-native-envelock",
  "version": "0.1.0",
  "description": "Encrypted local storage for React Native, backed by the Secure Enclave and Android Keystore.",
  "license": "Apache-2.0",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/ShareRing/envelock.git",
    "directory": "bindings/react-native"
  },
  "homepage": "https://github.com/ShareRing/envelock",
  "publishConfig": {
    "access": "public"
  },
  "main": "src/index.ts",
  "types": "src/index.ts",
  "react-native": "src/index.ts",
  "source": "src/index.ts",
  "exports": {
    ".": "./src/index.ts",
    "./testing": "./src/testing.ts",
    "./package.json": "./package.json"
  },
  "files": [
    "src",
    "cpp",
    "ios",
    "android/src",
    "android/CMakeLists.txt",
    "android/build.gradle",
    "android/consumer-rules.pro",
    "*.podspec",
    "CHANGELOG.md",
    "LICENSE",
    "!**/__tests__"
  ],
  "scripts": {
    "typecheck": "tsc --noEmit",
    "test": "jest"
  },
  "peerDependencies": {
    "react": "*",
    "react-native": "*"
  },
  "devDependencies": {
    "@types/jest": "^29.5.12",
    "@types/node": "^26.4.1",
    "@types/react": "^18.2.0",
    "jest": "^29.7.0",
    "react-native": "^0.87.1",
    "ts-jest": "^29.1.2",
    "typescript": "^5.4.0"
  },
  "jest": {
    "preset": "ts-jest",
    "testEnvironment": "node"
  }
