<?xml version="1.0" encoding="utf-8"?>
<!--
  The enclave key is gated behind the framework BiometricPrompt, which needs this permission.
  It is a normal permission: granted at install, never requested at runtime, and it merges into
  the consuming app's manifest so no integrator has to declare it.
-->
<manifest xmlns:android="http://schemas.android.com/apk/res/android">
    <uses-permission android:name="android.permission.USE_BIOMETRIC" />
</manifest>
